{
  "name": "infobox-live",
  "version": "1.0.0",
  "private": true,
  "description": "Float infobox callouts beside your text in Live Preview, insert them from the Insert menu, and move, resize or delete them with a right-click.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  },
  "author": "DVelascoHerruzo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DVelascoHerruzo/obsidian-infobox-live.git"
  }
}
